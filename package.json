{
  "name": "maison-verane",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MAISON VÉRANE — an original fictional luxury watchmaking experience. Aéroform collection prototype.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
